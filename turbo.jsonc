{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "test:playwright": {},
    "lint": {},
    "clean": {
      "cache": false
    },
    "console:dev": {
      "cache": false,
      "persistent": true
    },
    "console:start": {
      "cache": false,
      "persistent": true
    },
    "ee-api:dev": {
      "cache": false,
      "persistent": true
    },
    "rotor:dev": {
      "cache": false,
      "persistent": true
    },
    "profiles:dev": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
