{
  "name": "root",
  "version": "0.0.0",
  "private": false,
  "packageManager": "bun@1.3.2",
  "scripts": {
    "build-scripts": "bun --filter ./cli/build-scripts run exec",
    "codegen": "bun --filter @jitsu-internal/console prisma generate",
    "format:check": "prettier --ignore-unknown --check --config ./.prettierrc.json --ignore-path ./.prettierignore $(git diff --name-only --diff-filter d | xargs)",
    "format:check:all": "prettier --check --config ./.prettierrc.json --ignore-path ./.prettierignore .",
    "format": "prettier --ignore-unknown --write --config ./.prettierrc.json --ignore-path ./.prettierignore $(git diff --name-only --diff-filter d | xargs)",
    "format:all": "prettier --write --config ./.prettierrc.json --ignore-path ./.prettierignore .",
    "tool:hash": "turbo run tool:hash --",
    "ci:no-test": "bun format:check:all && bun lint && bun build",
    "ci:all": "bun ci:no-test && bun test",
    "prepare": "husky install",
    "pre-commit": "bun format:check",
    "build:turbo": "turbo run build",
    "build": "turbo run build",
    "typecheck:turbo": "turbo run typecheck",
    "typecheck": "turbo run typecheck",
    "ee-api:dev": "dotenv -e .env.local -- turbo run ee-api:dev",
    "console:dev": "dotenv -e .env.local -- turbo run console:dev",
    "rotor:dev": "dotenv -e .env.local -- turbo run rotor:dev",
    "console:start": "dotenv -e .env.local -- turbo run console:start",
    "console:db-prepare": "dotenv -e .env.local -- bun run --filter=console db:update-schema",
    "console:db-prepare-force": "dotenv -e .env.local -- bun run --filter=console db:update-schema-force",
    "dev": "dotenv -e .env.local -- turbo run dev",
    "test:turbo": "turbo run test",
    "test": "turbo run test",
    "test:playwright:turbo": "turbo run test:playwright",
    "test:playwright": "turbo run test:playwright",
    "jitsu-cli": "turbo run build --filter=jitsu-cli && node --enable-source-maps core/jitsu-cli/lib/index.js",
    "factory-reset": "bun clean ; bun clean:turbo ; rm -rf `find . -type d -name node_modules`",
    "clean:turbo": "turbo run clean || exit 0",
    "clean": "turbo run clean || exit 0",
    "lint:turbo": "turbo run lint --",
    "lint": "turbo run lint",
    "release": "bun build && bun test && monorel --filter ./types/protocols --filter ./cli/jitsu-cli --filter ./libs/functions --filter ./libs/jitsu-js --filter ./libs/jitsu-react --npm-tag latest --git-tag 'jitsu-js-libs-v{version}' --push-tag --version '1.10.4'",
    "release:build-scripts": "bun build --filter ./cli/build-scripts && monorel --filter ./cli/build-scripts --npm-tag latest --version 0.0.4-dev.{rev}.{time} --publish --git-tag 'jitsu-build-scripts-v{version}'",
    "release:canary": "monorel --filter ./types/protocols --filter ./cli/jitsu-cli --filter ./libs/functions --filter ./libs/jitsu-js --filter ./libs/jitsu-react --version '1.10.5-canary.{rev}.{time}' --npm-tag canary --git-tag 'jitsu-js-libs-canary-v{version}' --push-tag"
  },
  "devDependencies": {
    "@playwright/test": "1.39.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "dotenv-cli": "^6.0.0",
    "husky": "^8.0.3",
    "monorel": "0.4.2",
    "prettier": "^2.8.7",
    "semantic-release": "^23.0.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "yarn": ">=1000",
    "bun": ">=1.3.2",
    "npm": ">=1000",
    "node": ">=24"
  },
  "overrides": {
    "form-data": "^4.0.4",
    "zstd-napi": "^0.0.10",
    "nth-check": "2.1.1",
    "nanoid": "3.3.8",
    "postcss": "^8.4.47",
    "elliptic": "^6.6.1",
    "cross-spawn": "^7.0.6",
    "path-to-regexp": "^0.1.12"
  },
  "trustedDependencies": [
    "@confluentinc/kafka-javascript",
    "@firebase/util",
    "@mongodb-js/zstd",
    "@prisma/client",
    "@prisma/engines",
    "@swc/core",
    "core-js",
    "core-js-pure",
    "esbuild",
    "isolated-vm",
    "prisma",
    "protobufjs",
    "sharp",
    "turbo",
    "zstd-napi"
  ],
  "workspaces": {
    "packages": [
      "e2e",
      "examples/*",
      "types/*",
      "webapps/*",
      "services/*",
      "cli/*",
      "libs/*"
    ],
    "catalog": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1"
    }
  }
}
