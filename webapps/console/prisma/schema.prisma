generator zod {
  provider = "zod-prisma"
  output   = "./schema"

  relationModel         = false
  modelCase             = "PascalCase"
  modelSuffix           = "DbModel"
  useDecimalJs          = true
  prismaJsonNullability = true
}

generator client {
  provider        = "prisma-client-js"
  extendedIndexes = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailLog {
  id         String   @id @default(cuid())
  time       DateTime @default(now())
  email      Json
  error      String?
  previewUrl String?
  messageId  String?
  status     String
}

model UserPreferences {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt DateTime    @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id])

  //If preferences relates to workspace,
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  //empty or 'server-only'. Server-only means that preferences can't be changed from JS. NOT USED so far
  scope       String?
  preferences Json
}

model UserProfile {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String
  admin                   Boolean?                  @default(false)
  createdAt               DateTime                  @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt               DateTime                  @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  loginProvider           String
  externalUsername        String?
  externalId              String
  tokens                  UserApiToken[]
  workspaceAccess         WorkspaceAccess[]
  userPreferences         UserPreferences[]
  workspaceUserProperties WorkspaceUserProperties[]
  password                UserPassword?

  @@unique([loginProvider, externalId])
  @@index(externalId)
}

model UserPassword {
  id                String      @id @default(cuid())
  createdAt         DateTime    @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt         DateTime    @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  userId            String      @unique
  user              UserProfile @relation(fields: [userId], references: [id])
  hash              String
  changeAtNextLogin Boolean     @default(false)
}

model Workspace {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt DateTime @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  name      String
  deleted   Boolean  @default(false)

  slug                    String?
  workspaceAccess         WorkspaceAccess[]
  workspaceOptions        WorkspaceOptions[]
  configurationObject     ConfigurationObject[]
  configurationObjectLink ConfigurationObjectLink[]
  preferences             UserPreferences[]
  workspaceUserProperties WorkspaceUserProperties[]
  featuresEnabled         String[]                  @default([])
  profileBuilders         ProfileBuilder[]
  oidcLoginGroups         OidcLoginGroup[]

  @@unique(slug)
  @@index(slug)
  @@index(updatedAt(sort: Desc))
}

//additional properties for workspace
model WorkspaceOptions {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt   DateTime  @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  namespace   String
  value       Json

  @@index([workspaceId, namespace])
}

enum WorkspaceRole {
  owner
  editor
  analyst
}

model WorkspaceAccess {
  workspaceId String
  createdAt   DateTime      @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt   DateTime      @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  userId      String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  user        UserProfile   @relation(fields: [userId], references: [id])
  role        WorkspaceRole @default(owner)

  @@id([userId, workspaceId])
}

model WorkspaceUserProperties {
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  userId      String
  user        UserProfile @relation(fields: [userId], references: [id])
  lastUsed    DateTime    @default(now()) /// @zod.custom(z.coerce.date())

  @@id([workspaceId, userId])
}

model UserApiToken {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt DateTime    @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  lastUsed  DateTime? /// @zod.custom(z.coerce.date())
  hint      String
  hash      String
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id])
  type      String?
  name      String?
  expiresAt DateTime? /// @zod.custom(z.coerce.date())

  // For MCP-issued tokens: oauthClientId is set and this row IS the refresh
  // token. MCP-ness is inferred from oauthClientId IS NOT NULL (we don't set
  // type="mcp"). For non-MCP keys (UI/CLI/api) oauthClientId is null.
  oauthClientId String?
  oauthClient   OAuthClient?       @relation(fields: [oauthClientId], references: [id])
  accessTokens  OAuthAccessToken[]
}

model OAuthClient {
  id               String   @id @default(cuid()) // == OAuth client_id
  createdAt        DateTime @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt        DateTime @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  clientSecretHash String // hashed via juava.createHash
  name             String // from DCR client_name; shown on /user
  redirectUris     String[] // whitelisted at DCR time

  // Schema is 1:N (a client could in principle hold many refresh tokens).
  // We enforce 1:1 in code:
  //   1. At /oauth/token (authorize success): delete any existing
  //      UserApiToken rows for this client (cascading to their access
  //      tokens) before creating the new one.
  //   2. At DELETE /api/user/keys: when a token with oauthClientId is
  //      deleted, also delete the OAuthClient row and its access tokens
  //      in the same transaction.
  // To migrate to 1:N later: drop step (1) and replace step (2) with a
  // separate "revoke connection" action. No schema change required.
  tokens UserApiToken[]
}

// Generic key-value store used by the MCP server (and any future feature
// that wants ephemeral or atomic key/value semantics). Single flat
// namespace; callers separate concerns via key prefix conventions
// (`oauth:code:...`, `mcp:event:...`). See lib/server/kv/.
model KvStoreEntry {
  key       String    @id
  value     Json
  expiresAt DateTime? @map("expires_at") /// @zod.custom(z.coerce.date())

  @@index([expiresAt])
  // Prefix scans (`segment1:segment2:*`) need text_pattern_ops to use the
  // index — the default text ops only help equality and ordering. With this
  // ops class, `WHERE key LIKE 'prefix%'` becomes an index range scan.
  @@index([key(ops: raw("text_pattern_ops"))], map: "kv_key_pattern_idx")
  @@map("kv")
}

model OAuthAccessToken {
  id             String       @id @default(cuid()) // bearer keyId
  createdAt      DateTime     @default(now()) /// @zod.custom(z.coerce.date())
  lastUsed       DateTime? /// @zod.custom(z.coerce.date())
  hash           String // juava.createHash(plaintext); no hint (never shown)
  expiresAt      DateTime /// @zod.custom(z.coerce.date())
  refreshTokenId String // user is inferred via refreshToken.userId
  refreshToken   UserApiToken @relation(fields: [refreshTokenId], references: [id])

  @@index([expiresAt])
  @@index([refreshTokenId])
}

model InvitationToken {
  id          String @id @default(cuid())
  workspaceId String

  email     String
  createdAt DateTime      @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt DateTime      @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  token     String
  usedBy    String?
  role      WorkspaceRole @default(owner)
}

model ConfigurationObject {
  id          String    @id @default(cuid())
  deleted     Boolean?  @default(false)
  createdAt   DateTime  @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt   DateTime  @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  type        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  config      Json?

  fromLinks              ConfigurationObjectLink[] @relation("from")
  toLinks                ConfigurationObjectLink[] @relation("to")
  ProfileBuilder         ProfileBuilder[]
  ProfileBuilderFunction ProfileBuilderFunction[]

  @@index(updatedAt(sort: Desc))
}

model ConfigurationObjectLink {
  id        String   @id @default(cuid())
  deleted   Boolean? @default(false)
  createdAt DateTime @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt DateTime @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  type      String?  @default("push")
  data      Json?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  fromId String
  from   ConfigurationObject @relation(fields: [fromId], references: [id], name: "to")

  toId String
  to   ConfigurationObject @relation(fields: [toId], references: [id], name: "from")

  @@index(updatedAt(sort: Desc))
  @@index(workspaceId)
}

model ConnectorPackage {
  id          String   @id @default(cuid())
  packageId   String
  packageType String   @default("airbyte")
  meta        Json?
  logoSvg     Bytes?
  createdAt   DateTime @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt   DateTime @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
}

model AuditLog {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now()) /// @zod.custom(z.coerce.date())
  type           String
  severity       String?  @default("info")
  userId         String?
  workspaceId    String?
  objectId       String?
  changes        Json?
  authType       String?
  tokenId        String?
  ip             String?
  requestHeaders Json?

  @@index(timestamp)
  @@index(type)
  @@index([workspaceId, timestamp])
}

model GlobalProps {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) /// @zod.custom(z.coerce.date())
  updatedAt DateTime @default(now()) @updatedAt /// @zod.custom(z.coerce.date())
  name      String
  value     Json?
}

model source_spec {
  package   String
  version   String
  specs     Json?
  timestamp DateTime @default(now()) @db.Timestamptz(3) /// @zod.custom(z.coerce.date())
  error     String?

  @@id([package, version])
}

model source_check {
  package     String
  version     String
  key         String   @id
  status      String
  description String?
  timestamp   DateTime @default(now()) @db.Timestamptz(3) /// @zod.custom(z.coerce.date())
}

model source_catalog {
  package     String
  version     String
  key         String
  catalog     Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(3) /// @zod.custom(z.coerce.date())
  status      String
  description String?

  @@id([package, version, key])
}

// Reverse ETL tables share the config database schema and its update workflow.
// Prisma defines their schema/types; the Node runner uses pg for atomic transactions.
// Worker coordination belongs to Kubernetes leases and syncctl, not these tables.
enum reverse_sync_mode {
  upsert
  mirror
}

enum reverse_sync_extraction {
  cursor
  full
}

enum reverse_sync_action {
  upsert
  remove
}

// One durable lifecycle record per sync: current logical run, immutable config/target
// binding, phase, in-progress provider state, sequence boundaries and storage budgets.
// Unlike source_task (one execution attempt), this survives retries of the same run.
// source_state holds committed checkpoints; this row also tracks unfinished work.
model reverse_sync_control {
  workspace_id         String
  sync_id              String                  @unique
  run_id               String
  revision             String
  target_hash          String
  phase                String                  @default("new")
  mode                 reverse_sync_mode
  extraction           reverse_sync_extraction
  // Immutable object-storage manifest reference. Non-null selects object-backed
  // persistence; legacy per-row state requires an explicit operator reset.
  artifact_head        Bytes?
  base_sequence        BigInt                  @default(0)
  next_sequence        BigInt                  @default(0)
  checkpoint_sequence  BigInt                  @default(0)
  finish_sequence      BigInt?
  store                Bytes?
  provider_state       Bytes?
  finish_result        Bytes?
  committed_generation String?
  membership_entries   BigInt                  @default(0)
  membership_bytes     BigInt                  @default(0)
  journal_bytes        BigInt                  @default(0)
  reserved_entries     BigInt                  @default(0)
  reserved_bytes       BigInt                  @default(0)

  @@id([workspace_id, sync_id])
}

// Persistent exclusive claim of a destination audience by a mirror sync. Prevents
// other mirror/upsert syncs from managing that same target across runs/workspaces.
// This is audience ownership, not a worker lease; it survives completion/failure.
model reverse_sync_target_owner {
  target_hash  String @id
  workspace_id String
  sync_id      String

  @@unique([workspace_id, sync_id])
}

// Delivery journal entry for a batch: exact prepared request plus its saved receipt.
// Written before the provider call so recovery can reconcile/replay the original
// request without rerunning changed source SQL. Groups the operations below.
model reverse_sync_batch {
  workspace_id  String
  sync_id       String
  run_id        String
  batch_id      String
  manifest      Bytes
  manifest_hash String
  result        Bytes?
  result_bytes  BigInt
  status        String                   @default("prepared")
  created_at    DateTime                 @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  operations    reverse_sync_operation[]

  @@id([workspace_id, sync_id, run_id, batch_id])
  @@index([workspace_id, sync_id, created_at, batch_id], map: "reverse_sync_batch_retention")
}

// Per-operation delivery outcome and projected audience effects within a batch.
// Tracks unresolved/accepted/rejected work, source ordering and reserved capacity.
// Accepted receipts drive membership changes and checkpoint eligibility atomically;
// these are recovery records, not billing events or task-log messages.
model reverse_sync_operation {
  workspace_id     String
  sync_id          String
  run_id           String
  operation_id     String
  batch_id         String
  sequence         BigInt
  action           reverse_sync_action
  status           String              @default("prepared")
  effects          Bytes
  // Core-projected hashes support source-order membership updates without decoding the run journal.
  identity_hashes  String[]
  reserved_entries BigInt
  reserved_bytes   BigInt
  // Local acknowledgement time, not a provider delivery timestamp or billing attribution.
  accepted_at      DateTime?           @db.Timestamptz(6)
  batch            reverse_sync_batch  @relation(fields: [workspace_id, sync_id, run_id, batch_id], references: [workspace_id, sync_id, run_id, batch_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspace_id, sync_id, run_id, operation_id])
  @@unique([workspace_id, sync_id, run_id, sequence])
  @@index([workspace_id, sync_id, run_id, status, sequence], map: "reverse_sync_operation_pending")
  @@index([identity_hashes], type: Gin, map: "reverse_sync_operation_identities")
}

// Metadata for one full desired-audience snapshot (generation = logical run ID).
// Tracks extraction size and retryable page progress; sealing marks complete input.
// Final accepted delivery promotes the generation via reverse_sync_control;
// abandoned/superseded generations are later pruned.
model reverse_sync_generation {
  workspace_id String
  sync_id      String
  generation   String
  sealed       Boolean @default(false)
  key_count    BigInt  @default(0)
  entry_count  BigInt  @default(0)
  byte_count   BigInt  @default(0)

  // Atomic receipt for the latest source page; no per-source identity association.
  last_page_sequence BigInt  @default(0)
  last_page_hash     String?
  // Fixed at snapshot creation, so recovery never changes which members need refresh.
  refresh_before     DateTime? @db.Timestamptz(3)

  @@id([workspace_id, sync_id, generation])
}

// Unique source primary-key hashes seen in a snapshot, including deliberately
// excluded rows. Detects duplicate source rows across pages without retaining raw
// warehouse rows or a source-row-to-destination-identity association table.
model reverse_sync_source_key {
  workspace_id String
  sync_id      String
  generation   String
  key_hash     String

  @@id([workspace_id, sync_id, generation, key_hash])
}

// Deduplicated destination identities and provider-ready payloads desired by one
// snapshot. Multiple source rows can produce the same identity. Comparing these
// rows with reverse_sync_membership produces bounded addition/removal pages.
model reverse_sync_desired {
  workspace_id  String
  sync_id       String
  generation    String
  identity_hash String
  payload_hash  String
  value         Bytes

  @@id([workspace_id, sync_id, generation, identity_hash])
}

// Effective audience membership durably acknowledged by Jitsu, across all runs.
// Updated on every accepted effect, including partial success in a failed run;
// later snapshot diffs therefore retain accepted work instead of using only the
// last successful snapshot. Stores payloads needed for comparison and removal.
model reverse_sync_membership {
  workspace_id  String
  sync_id       String
  identity_hash String
  payload_hash  String
  value         Bytes
  // Last provider-confirmed upsert, including unchanged-member expiry refresh.
  last_accepted_at DateTime @default(now()) @db.Timestamptz(3)

  @@id([workspace_id, sync_id, identity_hash])
}

// Shared committed checkpoint storage for connector syncs and Reverse ETL.
// Reverse ETL uses the _REVERSE_ETL_ stream for scoped cursor/sequence, provider
// store and generation state; detailed unfinished delivery stays in its journal.
model source_state {
  sync_id   String
  stream    String
  state     Json
  timestamp DateTime @default(now()) @db.Timestamptz(3) /// @zod.custom(z.coerce.date())

  @@id([sync_id, stream])
}

// Shared execution-attempt status and heartbeat for syncctl-managed syncs.
// Each Reverse ETL attempt gets a task ID; multiple attempts may recover the same
// logical run in reverse_sync_control. Task success is not a per-row receipt.
model source_task {
  sync_id     String
  task_id     String   @id
  package     String
  version     String
  started_at  DateTime @default(now()) @db.Timestamptz(3) /// @zod.custom(z.coerce.date())
  updated_at  DateTime @default(now()) @db.Timestamptz(3) /// @zod.custom(z.coerce.date())
  started_by  Json?
  status      String
  description String?
  metrics     Json?
  error       String?

  @@index(sync_id)
  @@index(started_at)
  // Backs syncctl's CleanupTaskLogs retention sweep
  // (bulker/sync-sidecar/db/db.go). Lets the per-sync window function be
  // index-only — without this the hourly DELETE scans the whole table.
  @@index([sync_id, started_at(sort: Desc)])
}

// Diagnostic messages attached to a sync/task execution attempt. Reverse ETL writes
// core-owned lifecycle messages here; delivery receipts and recovery evidence live
// in reverse_sync_batch/reverse_sync_operation instead of being inferred from logs.
model task_log {
  id        String   @id @default(uuid()) @db.Uuid
  level     String
  logger    String
  message   String
  sync_id   String
  task_id   String
  timestamp DateTime @default(now()) @db.Timestamptz(3) /// @zod.custom(z.coerce.date())

  @@index(sync_id)
  @@index(task_id)
  @@index(timestamp)
}

model ProfileBuilder {
